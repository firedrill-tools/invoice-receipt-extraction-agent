{
  "schemaVersion": "2026-10-14",
  "name": "invoice and receipt extraction \u2014 actual application",
  "target": {
    "kind": "command",
    "argv": [
      "node",
      "firedrill/target.mjs"
    ]
  },
  "scenarios": [
    {
      "id": "ordinary-invoice",
      "name": "Ordinary invoice",
      "input": {
        "caseId": "ordinary-invoice"
      }
    },
    {
      "id": "inconsistent-total",
      "name": "Inconsistent printed total",
      "input": {
        "caseId": "inconsistent-total"
      }
    }
  ],
  "repetitions": 1,
  "concurrency": 1,
  "limits": {
    "timeoutMs": 180000,
    "maxRuns": 2,
    "maxOutputBytes": 4194304
  }
}
